{
  "name": "timbre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI phone manager: LLMs (API or CLI PTY) on real phones via telefony-app (PhAP)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p web/tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "npm run build && node dist-server/src/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@primeuix/themes": "^1.2.5",
    "ajv": "^8.20.0",
    "node-pty": "^1.1.0",
    "primevue": "^4.5.5",
    "swagger-ui-dist": "^5.34.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
